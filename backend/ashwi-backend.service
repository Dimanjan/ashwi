[Unit]
Description=Ashwi Furniture FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/ashwi
Environment="PATH=/var/www/ashwi/venv/bin:/usr/local/bin:/usr/bin"
Environment="MEDIA_DIR=/var/www/ashwi/backend/media"
Environment="DB_PATH=/var/www/ashwi/backend/ashwi.sqlite3"
ExecStart=/var/www/ashwi/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 2 --loop uvloop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
